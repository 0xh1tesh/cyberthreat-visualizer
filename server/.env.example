# ─────────────────────────────────────────────────────────────
# Threat Intelligence API —> Environment Template
# Copy to .env and replace all placeholder values with real keys.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000

# Comma-separated browser origins allowed to call the API (CORS allowlist).
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Max requests per minute per client for the AI endpoints (/api/analyze, /api/report).
AI_RATE_LIMIT_PER_MIN=10

# How often the AbuseIPDB blacklist is refreshed (ms). The free plan allows very few
# blacklist calls per day, so the default of 6 hours (21600000) stays well under quota.
# Valid range: 600000-86400000.
ABUSE_REFRESH_MS=21600000

# Feeds cannot observe attack victims, so every arc ends at one neutral monitoring node.
SENSOR_LAT=20
SENSOR_LNG=0

# ── Threat Intelligence Providers ─────────────────────────────
# AbuseIPDB  — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=your_abuseipdb_key_here

# IPinfo  — https://ipinfo.io/account/token
IPINFO_API_KEY=your_ipinfo_key_here

# AlienVault OTX  — https://otx.alienvault.com/api (optional — works without key in public mode)
OTX_API_KEY=your_otx_key_here

# Shodan  — https://account.shodan.io
SHODAN_API_KEY=your_shodan_key_here

# ── AI Classification Layer ────────────────────────────────────
# AI_PROVIDER controls which AI backend is used for threat classification.
# Options: auto | openai | gemini | off
#   auto   —> tries Gemini first, falls back to OpenAI, then rule-based
#   openai —> force OpenAI (disabled if OPENAI_API_KEY is missing)
#   gemini —> force Gemini (disabled if GEMINI_API_KEY is missing)
#   off    —> disable AI classification entirely (rule-based scoring only)
AI_PROVIDER=auto

# OpenAI  — https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Google Gemini  — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_key_here

# Model used when AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Model used when AI_PROVIDER=gemini (or when /api/report is forced to Gemini)
GEMINI_MODEL=gemini-flash-latest

# Gemini free tier hard limits — do not exceed
GEMINI_MAX_RPM=5
GEMINI_MAX_RPD=20

# Maximum milliseconds to wait for an AI response before falling back to rule-based scoring
# Valid range: 200–800
AI_CLASSIFIER_TIMEOUT_MS=800

# Minimum rule score required before AI classification is considered
AI_MIN_SCORE=40

# Score window treated as ambiguous SCAN/MALWARE boundary
AI_AMBIGUOUS_SCORE_MIN=35
AI_AMBIGUOUS_SCORE_MAX=55

# Run AI only for top N rule-scored threats per aggregation cycle
AI_TOP_N=3

# Global AI call cooldown in milliseconds (~3 requests/sec at 300ms)
AI_THROTTLE_MS=300

# AI cache TTL in milliseconds (valid range: 300000–600000)
AI_CACHE_TTL_MS=600000

# Backward compatibility (legacy names still supported by server/index.js)
# AI_MIN_SCORE_FOR_CALL=40
# AI_TOP_N_THREATS=3

# Maximum milliseconds to wait for /api/report AI summary generation
# Set to 0 to disable timeout for /api/report AI generation.
# Valid range when enabled: 1000–120000
AI_REPORT_TIMEOUT_MS=0
